# Server Configuration
NODE_ENV=development
PORT=4000

# CORS Configuration (optional)
CORS_ORIGIN=*

# MongoDB Configuration
# For local development: mongodb://localhost:27017/rescuegrid
# For Docker: mongodb://mongodb:27017/rescuegrid
# For Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb://localhost:27017/rescuegrid

# JWT Authentication Configuration
# Generate a secure random secret for production:
#   Node.js: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   Linux: openssl rand -hex 64
# The server refuses to start with NODE_ENV=production while JWT_SECRET is
# still the built-in development value.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m

# Cookie Configuration
# Set to "none" with Secure=true for cross-origin requests
# Set to "lax" or "strict" for same-site requests
COOKIE_SAME_SITE=lax

# Email Configuration (SMTP / Gmail or Resend)
EMAIL_PROVIDER=RESEND
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@rescuegrid.ai

# MSG91 SMS Configuration
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Security Notes:
# - Never commit .env files to version control
# - Use strong, randomly generated secrets in production
# - Rotate JWT secrets periodically
# - Enable CORS_ORIGIN for production to restrict allowed origins
