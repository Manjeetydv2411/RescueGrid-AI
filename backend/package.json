{
  "name": "rescuegrid-backend",
  "version": "1.0.0",
  "description": "AI-powered Emergency and Disaster Response Coordination Platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ai": "cd ai-service && .venv/bin/python -m uvicorn app.main:app --reload",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:demo": "tsx src/scripts/seedDemoData.ts",
    "bootstrap:admin": "tsx src/scripts/bootstrapAdmin.ts",
    "test": "MONGODB_URI=mongodb://127.0.0.1:27017/rescuegrid_test vitest run --fileParallelism=false",
    "test:ai": "cd ai-service && pytest tests/"
  },
  "keywords": [
    "emergency",
    "disaster",
    "response",
    "coordination",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.7.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.0",
    "@types/nodemailer": "^8.0.2",
    "@types/socket.io": "^3.0.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.3"
  }
}
